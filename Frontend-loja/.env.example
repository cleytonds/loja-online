# URL pública da API Express (obrigatória para build/deploy fora do localhost).
# Não inclua barra final nem credenciais nesta variável pública.
VITE_API_URL=https://api.exemplo.com.br

# Public Key do Mercado Pago. Necessária apenas se o frontend passar a
# inicializar SDKs ou Bricks; não inclua a chave real neste arquivo.
VITE_MERCADO_PAGO_PUBLIC_KEY=
